@startuml Campus IT Help Desk ER
hide circle
skinparam nodesep 90
skinparam ranksep 110
skinparam padding 6
skinparam roundCorner 8
skinparam shadowing false
skinparam ArrowColor #555555
skinparam ArrowFontColor #555555
skinparam class {
  BackgroundColor #FAFAFA
  BorderColor #444444
  HeaderBackgroundColor #DDE7F0
}

' ── People & groups ─────────────────────────────

entity "USER" as user {
  * id : int <<PK>>
  --
  * username : varchar <<UK>>
  * email : varchar <<UK>>
  * password : varchar
  * first_name : varchar
  * last_name : varchar
  * role : varchar = 'reporter'
    bio : text
    avatar : varchar
  * is_active : bool = true
  * is_superuser : bool = false
  * created_at : datetime
}

entity "TEAM_MEMBER" as tm {
  * id : int <<PK>>
  --
  * user_id : int <<FK>>
  * team_id : int <<FK>>
  * joined_at : datetime
  unique (user_id, team_id)
}

entity "TEAM" as team {
  * id : int <<PK>>
  --
  * name : varchar <<UK>>
    description : text
    lead_id : int <<FK>>
  * created_at : datetime
}

' ── What we support ─────────────────────────────

entity "SERVICE" as service {
  * id : int <<PK>>
  --
  * name : varchar
    description : text
    owning_team_id : int <<FK>>
  * criticality : varchar = 'medium'
  * is_active : bool = true
  * created_at : datetime
}

' ── Tickets ─────────────────────────────────────

entity "INCIDENT" as incident {
  * id : int <<PK>>
  --
  * title : varchar
  * description : text
    building : varchar
    room : varchar
  * service_id : int <<FK>>
  * reported_by_id : int <<FK>>
    assigned_to_id : int <<FK>>
    assigned_team_id : int <<FK>>
  * status : varchar = 'open'
  * priority : varchar = 'medium'
  * escalation_level : int = 0
    escalated_at : datetime
    escalation_timer_started_at : datetime
  * is_unassigned_after_escalation : bool = false
    sla_due_at : datetime
    resolved_at : datetime
  * is_deleted : bool = false
  * created_at : datetime
  * updated_at : datetime
}

entity "INCIDENT_UPDATE" as upd {
  * id : int <<PK>>
  --
  * incident_id : int <<FK>>
  * author_id : int <<FK>>
  * update_type : varchar = 'note'
  * body : text
    old_status : varchar
    new_status : varchar
    old_assignee_id : int <<FK>>
    new_assignee_id : int <<FK>>
  * created_at : datetime
}

' ── Layout: users/teams on top, tickets below ───

user     -[hidden]right-  tm
tm       -[hidden]right-  team
team     -[hidden]down-   service
service  -[hidden]down-   incident
incident -[hidden]down-   upd

' ── Relationships ───────────────────────────────

user     ||--o{ tm       : belongs to
team     ||--o{ tm       : has
team     |o--o{ service  : owns
service  ||--o{ incident : has
user     ||--o{ incident : reports
user     |o--o{ incident : assigned to
team     |o--o{ incident : assigned team
incident ||--o{ upd      : has
user     ||--o{ upd      : writes
user     |o--o{ upd      : old assignee
user     |o--o{ upd      : new assignee


entity "SHIFT" as shift {
  * id : int <<PK>>
  --
  * team_id : int <<FK>>
  * solver_id : int <<FK>>
  * on_call_role : varchar = 'primary'
  * starts_at : datetime
  * ends_at : datetime
  * created_by_id : int <<FK>>
  * created_at : datetime
}

team ||--o{ shift : "has"
user ||--o{ shift : "covers"
user |o--o{ team : "leads"
user ||--o{ shift : "scheduled by"

entity "ESCALATION_TIER" as tier {
  * id : int <<PK>>
  --
  * team_id : int <<FK>>
  * tier_number : int
  * escalate_to : varchar
  escalate_to_user_id : int <<FK>>
  * wait_minutes : int
  * created_at : datetime
  * updated_at : datetime
  unique (team_id, tier_number)
}

entity "NOTIFICATION" as note {
  * id : int <<PK>>
  --
  * user_id : int <<FK>>
  incident_id : int <<FK>>
  * event : varchar
  * message : text
  * created_at : datetime
  read_at : datetime
  emailed_at : datetime
}

team ||--o{ tier : "has"
user |o--o{ tier : "named in"
user ||--o{ note : "receives"
incident |o--o{ note : "is about"

@enduml
