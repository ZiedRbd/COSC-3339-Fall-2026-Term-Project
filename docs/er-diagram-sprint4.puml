@startuml CampusDesk ER changes in Sprint 4
hide circle
hide empty members
skinparam nodesep 70
skinparam ranksep 80
skinparam padding 6
skinparam roundCorner 8
skinparam shadowing false
skinparam ArrowColor #555555
skinparam ArrowFontColor #555555
skinparam class {
  BackgroundColor #FAFAFA
  BorderColor #444444
  HeaderBackgroundColor #E4E5EA
}

title ER diagram: what changed between Sprint 3 and Sprint 4

legend top left
  |<#C9ECD3>          | New table |
  |<#FBEFAE>          | Changed table: every column, new ones marked **new** |
  |<#E4E5EA>          | Unchanged table, name only |
endlegend

' ── Unchanged since Sprint 3 ────────────────────

entity "TEAM" as team
entity "TEAM_MEMBER" as tm
entity "SERVICE" as service
entity "INCIDENT_UPDATE" as upd

' ── Changed in Sprint 4 ─────────────────────────

entity "USER" as user #FBEFAE {
  * id : int <<PK>>
  --
  * username : varchar <<UK>>
  * email : varchar <<UK>>
  * password : varchar
  * first_name : varchar
  * last_name : varchar
  * role : varchar = 'reporter'
    bio : text
  * is_active : bool = true
  * is_superuser : bool = false
  * created_at : datetime
  --
    avatar : varchar  **new**
}

entity "INCIDENT" as incident #FBEFAE {
  * id : int <<PK>>
  --
  * title : varchar
  * description : text
    building : varchar
    room : varchar
  * service_id : int <<FK>>
  * reported_by_id : int <<FK>>
    assigned_to_id : int <<FK>>
    assigned_team_id : int <<FK>>
  * status : varchar = 'open'
  * priority : varchar = 'medium'
  * escalation_level : int = 0
    escalated_at : datetime
    sla_due_at : datetime
    resolved_at : datetime
  * is_deleted : bool = false
  * created_at : datetime
  * updated_at : datetime
  --
    escalation_timer_started_at : datetime  **new**
  * is_unassigned_after_escalation : bool = false  **new**
}

entity "SHIFT" as shift #FBEFAE {
  * id : int <<PK>>
  --
  * team_id : int <<FK>>
  * solver_id : int <<FK>>
  * starts_at : datetime
  * ends_at : datetime
  * created_by_id : int <<FK>>
  * created_at : datetime
  --
  * on_call_role : varchar = 'primary'  **new**
}

' ── New in Sprint 4 ─────────────────────────────

entity "ESCALATION_TIER" as tier #C9ECD3 {
  * id : int <<PK>>
  --
  * team_id : int <<FK>>
  * tier_number : int
  * escalate_to : varchar
    escalate_to_user_id : int <<FK>>
  * wait_minutes : int
  * created_at : datetime
  * updated_at : datetime
  unique (team_id, tier_number)
  check (wait_minutes > 0)
}

entity "NOTIFICATION" as note #C9ECD3 {
  * id : int <<PK>>
  --
  * user_id : int <<FK>>
    incident_id : int <<FK>>
  * event : varchar
  * message : text
  * created_at : datetime
    read_at : datetime
    emailed_at : datetime
}

' ── Relationships ───────────────────────────────

user     ||--o{ tm       : belongs to
team     ||--o{ tm       : has
user     |o--o{ team     : leads
team     |o--o{ service  : owns
service  ||--o{ incident : has
user     ||--o{ incident : reports
user     |o--o{ incident : assigned to
team     |o--o{ incident : assigned team
incident ||--o{ upd      : has
user     ||--o{ upd      : writes
team     ||--o{ shift    : has
user     ||--o{ shift    : covers
team     ||--o{ tier     : has
user     |o--o{ tier     : named in
user     ||--o{ note     : receives
incident |o--o{ note     : is about

@enduml
