[Unit]
Description=CampusDesk gunicorn
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/srv/campusdesk
EnvironmentFile=/srv/campusdesk/.env
ExecStart=/srv/campusdesk/venv/bin/gunicorn --workers 3 --bind unix:/run/campusdesk.sock campusdesk.wsgi:application
Restart=always

[Install]
WantedBy=multi-user.target
